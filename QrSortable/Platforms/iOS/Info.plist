<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
	   <key>CFBundleIdentifier</key>
	    <string>com.danfe.qrsortable</string>
	    <key>CFBundleDisplayName</key>
	    <string>QrSortable</string>
	    <key>CFBundleName</key>
	    <string>QrSortable</string>
	    <key>CFBundleShortVersionString</key>
	    <string>1.1.1</string>
	    <key>CFBundleVersion</key>
	    <string>11</string>
		<key>MinimumOSVersion</key>
		<string>15.0</string>

		<key>LSRequiresIPhoneOS</key>
		<true />
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
			<integer>2</integer>
		</array>

		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>

		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>

		<!-- Background Fetch -->
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
		</array>
		
		<!-- Redirect url -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>com.danfe.qrsortable</string>
				<key>CFBundleURLSchemes</key>
				<array>
				<string>myapp</string>
				</array>
			</dict>
		</array>
				
		<!-- Permissions -->
		<key>NSCameraUsageDescription</key>
		<string>This app uses barcode scanning</string>
		
		<key>NSPhotoLibraryUsageDescription</key>
		<string>We need access to the photo library to save pictures.</string>

		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>This app needs access to the photo gallery for picking photos and videos.</string>

		<key>NSMicrophoneUsageDescription</key>
		<string>Voice search for stored items</string>
		
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>Speech recognition for searching items</string>

		<!-- Launch Screen -->
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>

		<!-- Status Bar Configuration -->
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>

		<!-- Supported Platforms -->
		<key>XSAppIconAssets</key>
		<string>Assets.xcassets/appicon.appiconset</string>
		
	</dict>
</plist>
