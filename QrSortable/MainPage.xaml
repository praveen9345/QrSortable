<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="QrSortable.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QrSortable.Resources"
    xmlns:localization="clr-namespace:QrSortable.Components.UiFunctionality.Localization"
    BackgroundImageSource="background_layout.png">
    <Grid
        BackgroundColor="{OnPlatform iOS='#525252'}"
        HorizontalOptions="FillAndExpand"
        VerticalOptions="FillAndExpand">
        <Grid.RowDefinitions>
            <!--  logo view  -->
            <RowDefinition Height="*" />
            <!--  home page  -->
            <RowDefinition Height="8*" />
        </Grid.RowDefinitions>

        <StackLayout Grid.Row="0">
            <Image
                Margin="0,100,0,0"
                Background="#525252"
                HeightRequest="100"
                HorizontalOptions="Center"
                Source="qr_barcode_icon"
                VerticalOptions="Start"
                WidthRequest="100" />

            <Label
                Margin="0,10,0,0"
                FontAttributes="Bold"
                FontFamily="ItimRegular"
                FontSize="Title"
                HorizontalTextAlignment="Center"
                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[MainPage_SmartLabel]}"
                TextColor="{StaticResource Primary}"
                VerticalTextAlignment="Start" />
        </StackLayout>


        <Button
            Grid.Row="1"
            BackgroundColor="{StaticResource Primary}"
            Clicked="OnClicked"
            ContentLayout="10,Right"
            CornerRadius="10"
            FontAttributes="Bold"
            FontFamily="ItimRegular"
            FontSize="Title"
            HorizontalOptions="Center"
            IsVisible="{OnPlatform iOS=true,
                                   Android=false}"
            Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[MainPage_HomePageText]}"
            TextColor="Black"
            VerticalOptions="Center">
            <Button.ImageSource>
                <FontImageSource
                    FontFamily="FluentIcons"
                    Glyph="{x:Static local:IconNames.Send}"
                    Color="Black" />
            </Button.ImageSource>
            <Button.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.3"
                    Radius="10"
                    Offset="5,5" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
