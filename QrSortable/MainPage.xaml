<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="QrSortable.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QrSortable.Resources"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundImageSource="{OnPlatform Android='background_layout',
                                       iOS='#525252'}">
    <ContentPage.Behaviors>
        <mct:StatusBarBehavior StatusBarColor="#525252" />
    </ContentPage.Behaviors>
    <Grid
        BackgroundColor="{OnPlatform iOS='#525252'}"
        HorizontalOptions="FillAndExpand"
        VerticalOptions="FillAndExpand">
        <Grid.RowDefinitions>
            <!--  logo view  -->
            <RowDefinition Height="*" />
            <!--  home page  -->
            <RowDefinition Height="8*" />
        </Grid.RowDefinitions>

        <StackLayout Grid.Row="0">
            <Image
                Margin="0,100,0,0"
                Background="#525252"
                HeightRequest="100"
                HorizontalOptions="Center"
                Source="qr_barcode_icon"
                VerticalOptions="Start"
                WidthRequest="100" />

            <Label
                Margin="0,10,0,0"
                FontAttributes="Bold"
                FontFamily="ItimRegular"
                FontSize="Title"
                HorizontalTextAlignment="Center"
                Text="Move Smarter. Store Safer."
                TextColor="{StaticResource Primary}"
                VerticalTextAlignment="Start" />
        </StackLayout>


        <Button
            Grid.Row="1"
            BackgroundColor="{StaticResource Primary}"
            Clicked="OnClicked"
            ContentLayout="10,Right"
            CornerRadius="10"
            FontAttributes="Bold"
            FontFamily="ItimRegular"
            FontSize="Title"
            HorizontalOptions="Center"
            IsVisible="{OnPlatform iOS=true,
                                   Android=false}"
            Text="Home Page"
            TextColor="Black"
            VerticalOptions="Center">
            <Button.ImageSource>
                <FontImageSource
                    FontFamily="FluentIcons"
                    Glyph="{x:Static local:IconNames.Send}"
                    Color="Black" />
            </Button.ImageSource>
            <Button.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.3"
                    Radius="10"
                    Offset="5,5" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
