<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Label" x:Key="Headline">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontFamily" Value="ItimRegular" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="NormalText">
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalTextAlignment" Value="Start" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="ItimRegular"/>
    </Style>

    <Style TargetType="Button" x:Key="BottomButton">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0,5,0,0" />
        <Setter Property="HeightRequest" Value="55" />
        <Setter Property="FontFamily" Value="ItimRegular" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource White}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property= "CornerRadius" Value="20" />
        <Setter Property= "ContentLayout" Value="Top,0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="TitleLabelStyle" TargetType="Label" >
        <Setter Property="FontFamily" Value="ItimRegular" />
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="TextColor" Value="Black"/>
    </Style>

    <Style x:Key="DialogButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
        <Setter Property="TextColor" Value="Black"/>
        <Setter Property="TextTransform" Value="None"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="VerticalOptions" Value="End"/>
        <Setter Property="FontFamily" Value="ItimRegular"/>
        <Setter Property="HeightRequest" Value="60"/>
    </Style>
</ResourceDictionary>
