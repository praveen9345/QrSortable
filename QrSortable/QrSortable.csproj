<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<RootNamespace>QrSortable</RootNamespace>
		<UseMaui>true</UseMaui>
	    <MauiVersion>9.0.0</MauiVersion>
		<OutputType Condition="'$(TargetFramework)' == 'net9.0-ios'">Exe</OutputType>
		<OutputType Condition="'$(TargetFramework)' == 'net9.0-android'">Exe</OutputType>
		<OutputType Condition="'$(TargetFramework)' == 'net9.0'">Library</OutputType>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AndroidSupportedOSVersion>21.0</AndroidSupportedOSVersion>
		<Configurations>Debug;Release;DebugEmulator;DebugDevice</Configurations>
		<UsingMauiEssentials>true</UsingMauiEssentials>

		<!-- Display name -->
		<ApplicationTitle>QrSortable</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.Danfe.QrSortable</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(AndroidSupportedOSVersion)</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'DebugEmulator'">
        <AndroidSupportedOSVersion>21</AndroidSupportedOSVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'DebugDevice'">
        <AndroidSupportedOSVersion>21.0</AndroidSupportedOSVersion>
    </PropertyGroup>
	<PropertyGroup>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<RunAOTCompilation>False</RunAOTCompilation>
		<PublishTrimmed>False</PublishTrimmed>
	</PropertyGroup>
	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2B0B98" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FDB623" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*.svg" BaseSize="300,300" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	
	<!-- Register the MAUI images -->
	<ItemGroup>
		<MauiImage Include="Resources\Images\background_layout.webp" />
	</ItemGroup>
 
    <!-- Register the AppResources files -->
	<ItemGroup>
       <Compile Update="Components\CoreFeatures\Scanner\Views\ItemDetailView.xaml.cs">
         <DependentUpon>ItemDetailView.xaml</DependentUpon>
       </Compile>
       <Compile Update="Components\CoreFeatures\Scanner\Views\BoxDetailView.xaml.cs">
         <DependentUpon>BoxDetailView.xaml</DependentUpon>
       </Compile>
       <Compile Update="Components\CoreFeatures\Scanner\Views\QrBrScannerView.xaml.cs">
         <DependentUpon>QrBrScannerView.xaml</DependentUpon>
       </Compile>
       <Compile Update="Components\UiFunctionality\Localization\AppResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppResources.resx</DependentUpon>
		</Compile>
       <Compile Update="Components\UiFunctionality\Notification\Views\DialogPhotoSelectionView.xaml.cs">
         <DependentUpon>DialogPhotoSelectionView.xaml</DependentUpon>
       </Compile>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BarcodeScanning.Native.Maui" Version="2.1.1" />
		<PackageReference Include="FirebaseAdmin" Version="3.1.0" />
		<PackageReference Include="Google.Cloud.Firestore" Version="3.9.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Maui" Version="9.0.2" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="JWT" Version="10.1.1" />
		<PackageReference Include="modernhttpclient-updated" Version="3.4.3" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Components\CoreFeatures\Cloud\AccessManagement\" />
	  <Folder Include="Components\CoreFeatures\Cloud\Wrappers\" />
	  <Folder Include="Components\CoreFeatures\Onboarding\" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Components\CoreFeatures\Scanner\Views\ItemDetailView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\CoreFeatures\Scanner\Views\BoxDetailView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\CoreFeatures\Scanner\Views\QrBrScannerView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\UiFunctionality\Notification\Views\DialogMoveToView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\UiFunctionality\Notification\Views\DialogActivityIndicatorView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\UiFunctionality\Notification\Views\DialogAlertView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\UiFunctionality\Notification\Views\DialogPhotoSelectionView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\UiFunctionality\Notification\Views\DialogGenericActivityIndicatorView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Components\UiFunctionality\Notification\Views\DialogRequestView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>
</Project>
