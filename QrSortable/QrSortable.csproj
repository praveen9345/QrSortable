       </Compile>
       <Compile Update="Components\CoreFeatures\OrdersPayments\Views\AddToBasketView.xaml.cs">
         <DependentUpon>AddToBasketView.xaml</DependentUpon>
       </Compile>
       <Compile Update="Components\CoreFeatures\Scanner\Views\ItemDetailView.xaml.cs">
         <DependentUpon>ItemDetailView.xaml</DependentUpon>
       </Compile>
       <Compile Update="Components\CoreFeatures\Scanner\Views\BoxDetailView.xaml.cs">
         <DependentUpon>BoxDetailView.xaml</DependentUpon>
       </Compile>
       <Compile Update="Components\CoreFeatures\CodeGenerator\Views\CodeGeneratorView.xaml.cs">
         <DependentUpon>CodeGeneratorView.xaml</DependentUpon>
       </Compile>
       <Compile Update="Components\CoreFeatures\Scanner\Views\QrBrScannerView.xaml.cs">
         <DependentUpon>QrBrScannerView.xaml</DependentUpon>
       </Compile>
       <Compile Update="Components\UiFunctionality\Localization\AppResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppResources.resx</DependentUpon>
		</Compile>
       <Compile Update="Components\UiFunctionality\Navigation\Views\MenuView.xaml.cs">
         <DependentUpon>MenuView.xaml</DependentUpon>
       </Compile>
       <Compile Update="Components\UiFunctionality\Notification\Views\DialogPhotoSelectionView.xaml.cs">
         <DependentUpon>DialogPhotoSelectionView.xaml</DependentUpon>
       </Compile>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BarcodeScanning.Native.Maui" Version="2.1.1" />
		<PackageReference Include="FirebaseAdmin" Version="3.1.0" />
		<PackageReference Include="Google.Cloud.Firestore" Version="3.9.0" />
		<PackageReference Include="Microsoft.AppCenter.Analytics" Version="5.0.7" />
