<?xml version="1.0" encoding="UTF-8" ?>
<views:BaseView
    x:Class="QrSortable.Components.CoreFeatures.Onboarding.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QrSortable.Resources"
    xmlns:views="clr-namespace:QrSortable.Components.UiFunctionality.Navigation.Views;assembly=QrSortable"
    xmlns:xct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundImageSource="background_layout.webp">
    <views:BaseView.Content>
        <Grid>
            <Grid.RowDefinitions>
                <!--  back  -->
                <RowDefinition Height="Auto" />
                <!--  item view  -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Back button  -->
            <Button
                Grid.Row="0"
                Margin="15,15,0,0"
                Padding="2"
                BackgroundColor="{StaticResource DarkGrey}"
                Command="{Binding BackNavigationCommand}"
                CornerRadius="5"
                HorizontalOptions="Start"
                VerticalOptions="Start">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.5"
                        Radius="10"
                        Offset="0,0" />
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FluentIcons"
                        Glyph="{x:Static local:IconNames.Back}"
                        Color="{StaticResource Primary}" />
                </Button.ImageSource>
            </Button>

            <!--  page icon  -->
            <Image
                Grid.Row="0"
                Margin="0,-20,0,0"
                Aspect="AspectFit"
                HeightRequest="150"
                HorizontalOptions="Center"
                Source="multiuser"
                VerticalOptions="Center" />

            <StackLayout Grid.Row="1">
                <Grid
                    Padding="10"
                    ColumnDefinitions="*,Auto"
                    VerticalOptions="Start">

                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="22"
                        LineBreakMode="WordWrap"
                        MaxLines="20"
                        Text="To support multiple users, we need a backend to securely store data. For your protection, all data sent to the backend is fully encrypted. To keep your information safe and enable multi-user features, encryption must be turned on."
                        TextColor="White"
                        VerticalOptions="Center" />

                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding IsMultiuserFunctionalityEnabled}"
                        VerticalOptions="Center">
                        <Switch.Behaviors>
                            <xct:EventToCommandBehavior Command="{Binding MultiuserFunctionalityToggledCommand}" EventName="Toggled" />
                        </Switch.Behaviors>
                    </Switch>

                </Grid>

                <Grid
                    Padding="10"
                    ColumnDefinitions="Auto,Auto"
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsMultiuserFunctionalityEnabled}"
                    VerticalOptions="Start">
                    <Label
                        Grid.Row="1"
                        Padding="0"
                        FontAttributes="Bold"
                        FontSize="28"
                        HorizontalOptions="Center"
                        Text="{Binding MultiuserId}"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />

                    <Button
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding CopyMultiuserCodeCommand}"
                        CornerRadius="20"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="16"
                        HorizontalOptions="Fill"
                        Text="Copy"
                        TextColor="Black"
                        VerticalOptions="Center">
                        <Button.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.3"
                                Radius="10"
                                Offset="5,5" />
                        </Button.Shadow>
                    </Button>
                </Grid>

                <Label
                    Grid.Column="0"
                    Margin="10,30,10,0"
                    FontAttributes="Bold"
                    FontFamily="ItimRegular"
                    FontSize="20"
                    LineBreakMode="WordWrap"
                    MaxLines="10"
                    Text="* Please provide the Multi-User ID for the other QRSortable app you wish to connect."
                    TextColor="Red"
                    VerticalOptions="Center" />

                <StackLayout
                    Grid.Row="0"
                    Margin="10,15,5,0"
                    Orientation="Horizontal">
                    <!--  item name  -->
                    <Label
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="20"
                        HorizontalTextAlignment="Center"
                        Text="Multiuser Id:"
                        TextColor="{StaticResource White}"
                        VerticalTextAlignment="Center" />

                    <!--  Placeholder for item name input field  -->
                    <Border
                        Margin="10,0,10,15"
                        Background="{StaticResource DarkGrey}"
                        HorizontalOptions="FillAndExpand"
                        StrokeShape="RoundRectangle 10">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.5"
                                Radius="10"
                                Offset="0,0" />
                        </Border.Shadow>
                        <!--  input field  -->
                        <Grid>
                            <Entry
                                Margin="10,0,0,0"
                                Placeholder="Enter code.."
                                PlaceholderColor="{StaticResource PlaceholderColor}"
                                Style="{StaticResource NormalText}"
                                Text="{Binding MultiuserIdInput}" />
                        </Grid>
                    </Border>
                </StackLayout>

                <Button
                    Margin="10,5,10,0"
                    BackgroundColor="{StaticResource Primary}"
                    Command="{Binding DoneCommand}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="ItimRegular"
                    FontSize="20"
                    HorizontalOptions="Fill"
                    Text="Done"
                    TextColor="Black"
                    VerticalOptions="Center">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.3"
                            Radius="10"
                            Offset="5,5" />
                    </Button.Shadow>
                </Button>
            </StackLayout>
        </Grid>
    </views:BaseView.Content>
</views:BaseView>
