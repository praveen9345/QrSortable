<?xml version="1.0" encoding="UTF-8" ?>
<views:BaseView
    x:Class="QrSortable.Components.CoreFeatures.Scanner.Views.ItemDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QrSortable.Resources"
    xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:QrSortable.Components.UiFunctionality.Navigation.Views;assembly=QrSortable"
    BackgroundImageSource="background_layout.webp">
    <views:BaseView.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="BoolInverter" />
        </ResourceDictionary>
    </views:BaseView.Resources>
    <views:BaseView.Content>
        <Grid>
            <Grid.RowDefinitions>
                <!--  back  -->
                <RowDefinition Height="Auto" />
                <!--  item view  -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Camera view  -->
            <scanner:CameraView
                x:Name="cameraView"
                Grid.Row="0"
                CameraEnabled="{Binding IsCameraEnabled}"
                CaptureNextFrame="{Binding IsCameraCapture}"
                CaptureQuality="High"
                IsVisible="{Binding IsCameraCaptureVisable}"
                OnImageCapturedCommand="{Binding ImageCapturedCommand}"
                TapToFocusEnabled="True" 
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand"/>

            <!--  Back button  -->
            <Button
                Grid.Row="0"
                Margin="15,15,0,0"
                Padding="2"
                BackgroundColor="{StaticResource DarkGrey}"
                Command="{Binding BackNavigationCommand}"
                CornerRadius="5"
                HorizontalOptions="Start"
                IsVisible="{Binding IsCameraCaptureVisable, Converter={StaticResource BoolInverter}}"
                VerticalOptions="Start">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.5"
                        Radius="10"
                        Offset="0,0" />
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FluentIcons"
                        Glyph="{x:Static local:IconNames.Back}"
                        Color="{StaticResource Primary}" />
                </Button.ImageSource>
            </Button>
            <!--  page icon  -->
            <Image
                Grid.Row="0"
                Aspect="AspectFit"
                HeightRequest="180"
                HorizontalOptions="Center"
                IsVisible="{Binding IsCameraCaptureVisable, Converter={StaticResource BoolInverter}}"
                Source="items_icon"
                VerticalOptions="Center" />

            <!--  capture buttom  -->
            <Button
                Margin="0,0,0,50"
                Padding="10"
                BackgroundColor="{StaticResource DarkGrey}"
                Command="{Binding CameraCommand}"
                CornerRadius="50"
                HorizontalOptions="Center"
                IsVisible="{Binding IsCameraCaptureVisable}"
                VerticalOptions="End">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.5"
                        Radius="10"
                        Offset="0,0" />
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FluentIcons"
                        Glyph="{x:Static local:IconNames.Capture}"
                        Size="50"
                        Color="{StaticResource Primary}" />
                </Button.ImageSource>
            </Button>

            <Grid Grid.Row="1" IsVisible="{Binding IsCameraCaptureVisable, Converter={StaticResource BoolInverter}}">
                <Grid.RowDefinitions>
                    <!--  item name  -->
                    <RowDefinition Height="Auto" />
                    <!--  item name  -->
                    <RowDefinition Height="Auto" />
                    <!--  item view  -->
                    <RowDefinition Height="*" />
                    <!--  add item image  -->
                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>

                <!--  item name  -->
                <StackLayout
                    Grid.Row="0"
                    Margin="10,0,5,0"
                    Orientation="Horizontal">
                    <!--  item name  -->
                    <Label
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        Text="Item Name:"
                        TextColor="{StaticResource White}"
                        VerticalTextAlignment="Center" />

                    <!--  Placeholder for item name input field  -->
                    <Border
                        Margin="10,0,0,0"
                        Background="{StaticResource DarkGrey}"
                        HorizontalOptions="FillAndExpand"
                        StrokeShape="RoundRectangle 10">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.5"
                                Radius="10"
                                Offset="0,0" />
                        </Border.Shadow>
                        <!--  input field  -->
                        <Grid>
                            <Entry
                                Margin="10,0,0,0"
                                Placeholder="Enter name.."
                                PlaceholderColor="{StaticResource PlaceholderColor}"
                                Style="{StaticResource NormalText}"
                                Text="{Binding ItemName}" />
                        </Grid>
                    </Border>
                </StackLayout>

                <!--  item remarks  -->
                <StackLayout
                    Grid.Row="1"
                    Margin="10,0,5,0"
                    Orientation="Horizontal">
                    <!--  remarks  -->
                    <Label
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        Text="Remarks:"
                        TextColor="{StaticResource White}"
                        VerticalTextAlignment="Center" />

                    <!--  Placeholder for more info input field  -->
                    <Border
                        Margin="10,10,0,10"
                        Background="{StaticResource DarkGrey}"
                        HorizontalOptions="FillAndExpand"
                        StrokeShape="RoundRectangle 10">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.5"
                                Radius="10"
                                Offset="0,0" />
                        </Border.Shadow>
                        <!--  input field  -->
                        <Grid>
                            <Entry
                                Margin="10,0,0,0"
                                Placeholder="More info..."
                                PlaceholderColor="{StaticResource PlaceholderColor}"
                                Style="{StaticResource NormalText}"
                                Text="{Binding ItemDescription}" />
                        </Grid>
                    </Border>
                </StackLayout>

                <Grid Grid.Row="2" Background="{StaticResource DarkGrey}">
                    <!--  default image icon  -->
                    <Image
                        Aspect="AspectFill"
                        HorizontalOptions="FillAndExpand"
                        Source="image_icon"
                        VerticalOptions="FillAndExpand" />
                    <!--  seprator  -->
                    <BoxView
                        HeightRequest="2"
                        VerticalOptions="Start"
                        Color="{StaticResource Yellow}" />
                    <!--  Carousel View  -->
                    <CarouselView
                        BackgroundColor="Transparent"
                        ItemsSource="{Binding ImageArray}"
                        Loop="False"
                        VerticalOptions="FillAndExpand">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <!--  boxes view  -->
                                <Grid Margin="2,0,2,0">
                                    <!--  images  -->
                                    <Image
                                        Aspect="AspectFill"
                                        HorizontalOptions="FillAndExpand"
                                        Rotation="{Binding Rotate}"
                                        Source="{Binding Image}"
                                        VerticalOptions="FillAndExpand" />

                                    <!--  Swipe view  -->
                                    <Button
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        CornerRadius="50"
                                        HeightRequest="30"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        WidthRequest="30">
                                        <Button.ImageSource>
                                            <FontImageSource
                                                FontFamily="FluentIcons"
                                                Glyph="{x:Static local:IconNames.Swipe}"
                                                Color="{StaticResource Yellow}" />
                                        </Button.ImageSource>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                    <!--  seprator  -->
                    <BoxView
                        HeightRequest="2"
                        VerticalOptions="End"
                        Color="{StaticResource Yellow}" />
                </Grid>

                <!--  add image button  -->
                <Button
                    Grid.Row="3"
                    Margin="0,15,80,15"
                    Padding="10"
                    BackgroundColor="{StaticResource Primary}"
                    Command="{Binding AddItemImagesCommand}"
                    CornerRadius="50"
                    HorizontalOptions="End"
                    VerticalOptions="End">
                    <Button.Shadow>
                        <Shadow
                            Brush="{StaticResource Primary}"
                            Opacity="0.5"
                            Radius="10"
                            Offset="0,0" />
                    </Button.Shadow>
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="FluentIcons"
                            Glyph="{x:Static local:IconNames.AddImage}"
                            Color="{StaticResource Black}" />
                    </Button.ImageSource>
                </Button>

                <!--  save button  -->
                <Button
                    Grid.Row="3"
                    Margin="0,15,15,15"
                    Padding="10"
                    BackgroundColor="{StaticResource Primary}"
                    Command="{Binding SaveCommand}"
                    CornerRadius="50"
                    HorizontalOptions="End"
                    VerticalOptions="End">
                    <Button.Shadow>
                        <Shadow
                            Brush="{StaticResource Primary}"
                            Opacity="0.5"
                            Radius="10"
                            Offset="0,0" />
                    </Button.Shadow>
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="FluentIcons"
                            Glyph="{x:Static local:IconNames.Save}"
                            Color="{StaticResource Black}" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Grid>
    </views:BaseView.Content>
</views:BaseView>



