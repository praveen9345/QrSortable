<?xml version="1.0" encoding="UTF-8" ?>
<views:BaseView
    x:Class="QrSortable.Components.CoreFeatures.Scanner.Views.ItemDetailView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QrSortable.Resources"
    xmlns:localization="clr-namespace:QrSortable.Components.UiFunctionality.Localization"
    xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:QrSortable.Components.UiFunctionality.Navigation.Views;assembly=QrSortable"
    BackgroundImageSource="background_layout.png">
    <views:BaseView.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="BoolInverter" />
        </ResourceDictionary>
    </views:BaseView.Resources>
    <views:BaseView.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Camera view  -->
            <scanner:CameraView
                x:Name="cameraView"
                Grid.Row="0"
                CameraEnabled="{Binding IsCameraEnabled}"
                CaptureNextFrame="{Binding IsCameraCapture}"
                CaptureQuality="High"
                IsVisible="{Binding IsCameraCaptureVisable}"
                OnImageCapturedCommand="{Binding ImageCapturedCommand}"
                TapToFocusEnabled="True" />

            <BoxView
                Grid.Row="0"
                BackgroundColor="{StaticResource StatusBarColor}"
                HorizontalOptions="FillAndExpand"
                IsVisible="{OnPlatform Android=false,
                                       iOS={Binding IsCameraCaptureVisable,
                                                    Converter={StaticResource BoolInverter}}}"
                VerticalOptions="FillAndExpand" />

            <!--  Back button  -->
            <Button
                Grid.Row="0"
                Margin="15,15,0,0"
                Padding="2"
                BackgroundColor="{StaticResource DarkGrey}"
                Command="{Binding BackNavigationCommand}"
                CornerRadius="5"
                HorizontalOptions="Start"
                IsVisible="{Binding IsCameraCaptureVisable, Converter={StaticResource BoolInverter}}"
                VerticalOptions="Start">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.5"
                        Radius="10"
                        Offset="0,0" />
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FluentIcons"
                        Glyph="{x:Static local:IconNames.Back}"
                        Color="{StaticResource Primary}" />
                </Button.ImageSource>
            </Button>

            <!--  page icon  -->
            <Image
                Grid.Row="0"
                Aspect="AspectFit"
                HeightRequest="130"
                HorizontalOptions="Center"
                IsVisible="{Binding IsCameraCaptureVisable, Converter={StaticResource BoolInverter}}"
                Source="items_icon"
                VerticalOptions="Center" />

            <!--  capture button  -->
            <Border
                Margin="0,0,0,50"
                Padding="0"
                BackgroundColor="{StaticResource DarkGrey}"
                HeightRequest="72"
                HorizontalOptions="Center"
                IsVisible="{Binding IsCameraCaptureVisable}"
                StrokeShape="RoundRectangle 36"
                VerticalOptions="End"
                WidthRequest="72">
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.5"
                        Radius="10"
                        Offset="0,0" />
                </Border.Shadow>
                <Button
                    Padding="0"
                    BackgroundColor="Transparent"
                    Command="{Binding CameraCommand}"
                    CornerRadius="36"
                    HeightRequest="72"
                    WidthRequest="72">
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="FluentIcons"
                            Glyph="{x:Static local:IconNames.Capture}"
                            Size="40"
                            Color="{StaticResource Primary}" />
                    </Button.ImageSource>
                </Button>
            </Border>

            <Grid
                Grid.Row="1"
                BackgroundColor="{OnPlatform iOS={StaticResource StatusBarColor}}"
                IsVisible="{Binding IsCameraCaptureVisable, Converter={StaticResource BoolInverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  item name  -->
                <StackLayout
                    Grid.Row="0"
                    Margin="10,0,5,0"
                    Orientation="Horizontal">
                    <Label
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[ItemDetailViewModel_ItemName]}"
                        TextColor="{StaticResource White}"
                        VerticalTextAlignment="Center" />
                    <Border
                        Margin="10,0,0,0"
                        Padding="5,5"
                        Background="{StaticResource DarkGrey}"
                        HorizontalOptions="FillAndExpand"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.5"
                                Radius="10"
                                Offset="0,0" />
                        </Border.Shadow>
                        <Grid>
                            <Entry
                                Margin="10,0,0,0"
                                Placeholder="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[ItemDetailViewModel_EnterNamePlace]}"
                                PlaceholderColor="{StaticResource PlaceholderColor}"
                                Style="{StaticResource NormalText}"
                                Text="{Binding ItemName}" />
                        </Grid>
                    </Border>
                </StackLayout>

                <!--  item remarks  -->
                <StackLayout
                    Grid.Row="1"
                    Margin="10,0,5,0"
                    Orientation="Horizontal">
                    <Label
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[ItemDetailViewModel_Remarks]}"
                        TextColor="{StaticResource White}"
                        VerticalTextAlignment="Center" />
                    <Border
                        Margin="10,10,0,10"
                        Padding="5,5"
                        Background="{StaticResource DarkGrey}"
                        HorizontalOptions="FillAndExpand"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.5"
                                Radius="10"
                                Offset="0,0" />
                        </Border.Shadow>
                        <Grid>
                            <Entry
                                Margin="10,0,0,0"
                                Placeholder="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[ItemDetailViewModel_MoreInfo]}"
                                PlaceholderColor="{StaticResource PlaceholderColor}"
                                Style="{StaticResource NormalText}"
                                Text="{Binding ItemDescription}" />
                        </Grid>
                    </Border>
                </StackLayout>

                <!--  Image carousel with zoom  -->
                <Grid Grid.Row="2" Background="{StaticResource DarkGrey}">
                    <Image
                        Aspect="AspectFill"
                        HorizontalOptions="FillAndExpand"
                        Source="image_icon"
                        VerticalOptions="FillAndExpand" />
                    <BoxView
                        HeightRequest="2"
                        VerticalOptions="Start"
                        Color="{StaticResource Yellow}" />

                    <!--  ZOOMABLE CAROUSEL - WORKS ON iOS & ANDROID  -->
                    <CarouselView
                        x:Name="imageCarousel"
                        BackgroundColor="Transparent"
                        ItemsSource="{Binding ImageArray}"
                        Loop="False"
                        VerticalOptions="FillAndExpand">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,0,2,0" BackgroundColor="Transparent">
                                    <Image
                                        Aspect="AspectFit"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="Center"
                                        Rotation="{Binding Rotate}"
                                        Source="{Binding Image}"
                                        VerticalOptions="Center">
                                        <Image.GestureRecognizers>
                                            <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                                            <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                                            <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <Button
                                        Margin="5"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        CornerRadius="50"
                                        HeightRequest="30"
                                        HorizontalOptions="End"
                                        InputTransparent="False"
                                        VerticalOptions="Start"
                                        WidthRequest="30">
                                        <Button.ImageSource>
                                            <FontImageSource
                                                FontFamily="FluentIcons"
                                                Glyph="{x:Static local:IconNames.Swipe}"
                                                Color="{StaticResource Yellow}" />
                                        </Button.ImageSource>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <BoxView
                        HeightRequest="2"
                        VerticalOptions="End"
                        Color="{StaticResource Yellow}" />
                </Grid>

                <!--  Action buttons  -->
                <Grid Grid.Row="3" BackgroundColor="{OnPlatform iOS={StaticResource StatusBarColor}}">

                    <Label
                        Margin="10,0,0,0"
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="20"
                        HorizontalTextAlignment="Start"
                        Text="{Binding SavingMessage}"
                        TextColor="#27F576"
                        VerticalTextAlignment="Center" />

                    <Button
                        Margin="0,15,80,15"
                        Padding="0"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding AddItemImagesCommand}"
                        CornerRadius="28"
                        HeightRequest="56"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        WidthRequest="56">
                        <Button.Shadow>
                            <Shadow
                                Brush="{StaticResource Primary}"
                                Opacity="0.5"
                                Radius="10"
                                Offset="0,0" />
                        </Button.Shadow>
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="FluentIcons"
                                Glyph="{x:Static local:IconNames.AddImage}"
                                Size="35"
                                Color="{StaticResource Black}" />
                        </Button.ImageSource>
                    </Button>

                    <!--  Save buttons  -->
                    <Button
                        Margin="0,15,15,15"
                        Padding="0"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding SaveCommand}"
                        CornerRadius="28"
                        HeightRequest="56"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        WidthRequest="56">
                        <Button.Shadow>
                            <Shadow
                                Brush="{StaticResource Primary}"
                                Opacity="0.5"
                                Radius="10"
                                Offset="0,0" />
                        </Button.Shadow>
                        <Button.ImageSource>
                            <FontImageSource
                                FontFamily="FluentIcons"
                                Glyph="{x:Static local:IconNames.Save}"
                                Size="35"
                                Color="{StaticResource Black}" />
                        </Button.ImageSource>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </views:BaseView.Content>
</views:BaseView>
