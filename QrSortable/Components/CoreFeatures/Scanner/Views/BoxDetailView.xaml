<?xml version="1.0" encoding="UTF-8"?>
<views:BaseView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QrSortable.Components.UiFunctionality.Navigation.Views;assembly=QrSortable"
    xmlns:local="clr-namespace:QrSortable.Resources"
    x:Class="QrSortable.Components.CoreFeatures.Scanner.Views.BoxDetailView">
    <views:BaseView.Content>
        <Grid>
             <Grid.RowDefinitions>
                    <!-- back -->
                    <RowDefinition Height="Auto"></RowDefinition>
                    <!-- Camera view -->
                    <RowDefinition Height="*"></RowDefinition>

             </Grid.RowDefinitions>

                <!-- Back button -->
                <Button
                    Grid.Row="0"
                    Margin="15,15,0,0"
                    Command="{Binding BackNavigationCommand}"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    BackgroundColor="{StaticResource DarkGrey}"
                    CornerRadius="5"
                    Padding="2">
                    <Button.Shadow>
                        <Shadow
                        Brush="Black"
                        Opacity="0.5"
                        Offset="0,0"
                        Radius="10"/>
                    </Button.Shadow>
                    <Button.ImageSource >
                        <FontImageSource 
                        FontFamily="FluentIcons" 
                        Color="{StaticResource Primary}"
                        Glyph="{x:Static local:IconNames.Back}"/>
                    </Button.ImageSource>
                </Button>

                <Image
                    Margin="0,-15,0,0"
                    Source="box"
                    Aspect="AspectFit"
                    HeightRequest="180"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
                <Label
                     FontSize="40"
                     Margin="0,110,0,0"
                     TextTransform="Uppercase"
                     FontAttributes="Bold"
                     FontFamily="ItimRegular"
                     Text="{Binding Barcode}" 
                     TextColor="{StaticResource Red}"
                     BackgroundColor="Transparent"
                     HorizontalTextAlignment="Center"/>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <!-- location -->
                        <RowDefinition Height="Auto"></RowDefinition>
                        <!-- category -->
                        <RowDefinition Height="Auto"></RowDefinition>
                        <!-- items -->
                        <RowDefinition Height="*"></RowDefinition>
                        <!-- add button -->
                        <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                    <StackLayout 
                        Grid.Row="0"
                        Margin="20,0,20,0"
                        Orientation="Horizontal">
                        <!-- location  -->
                        <Image           
                            HeightRequest="50"
                            WidthRequest="50"
                            Source="location"
                            Aspect="AspectFit"/>

                        <!-- Placeholder for location input field -->
                        <Border 
                             Margin="10"
                             Background="{StaticResource DarkGrey}"
                             StrokeShape="RoundRectangle 10"
                             HorizontalOptions="FillAndExpand">
                            <Border.Shadow>
                                <Shadow
                                Brush="Black"
                                Opacity="0.5"
                                Offset="0,0"
                                Radius="10"/>
                            </Border.Shadow>
                            <Grid >
                                <!-- input field -->
                                <Entry
                                    Margin="10,0,0,0"
                                    Placeholder="location ..." 
                                    Text="{Binding Location}"
                                    Style="{StaticResource NormalText}"/>
                            </Grid>
                        </Border>
                    </StackLayout>

                    <StackLayout 
                     Grid.Row="1"
                     Margin="20,0,20,0"
                     Orientation="Horizontal">
                        <!-- Category  -->
                        <Label
                          Text="Category:"               
                          FontAttributes="Bold"
                          FontFamily="ItimRegular"
                          FontSize="18"
                          TextColor="{StaticResource White}"
                          BackgroundColor="Transparent"
                          HorizontalTextAlignment="Center"
                          VerticalTextAlignment="Center"/>

                        <!-- Placeholder for category input field -->
                        <Border 
                          Margin="10"
                          Background="{StaticResource DarkGrey}"
                          StrokeShape="RoundRectangle 10"
                          HorizontalOptions="FillAndExpand">
                            <Border.Shadow>
                                <Shadow
                                 Brush="Black"
                                 Opacity="0.5"
                                 Offset="0,0"
                                 Radius="10"/>
                                </Border.Shadow>
                            <!-- input field -->
                            <Grid >
                                <Entry
                                 Margin="10,0,0,0"
                                 Placeholder="category ..." 
                                 Text="{Binding Category}"
                                 Style="{StaticResource NormalText}"/>
                            </Grid>
                        </Border>
                    </StackLayout>

                    <StackLayout
                     Grid.Row="2"
                     Background="{StaticResource DarkGrey}">
                         <!-- seprator -->
                         <BoxView 
                         HeightRequest="2"
                         Color="{StaticResource Yellow}"/>
                          <!-- collection view -->
                         <CollectionView 
                              SelectionMode="Single"
                              VerticalOptions="FillAndExpand">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="5">
                                         <!-- Box view -->
                                        <Border 
                                            Background="{StaticResource DarkGrey}"
                                            StrokeShape="RoundRectangle 10"
                                            HorizontalOptions="FillAndExpand">
                                            <Border.Shadow>
                                                <Shadow
                                                   Brush="Black"
                                                   Opacity="0.5"
                                                   Offset="0,0"
                                                   Radius="8"/>
                                            </Border.Shadow>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="7*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- first item image -->
                                                <Image
                                                   Grid.Column="0"
                                                   HeightRequest="40"
                                                   WidthRequest="40"
                                                   Source="location"
                                                   Aspect="AspectFit"/>
                                            
                                                <!-- Label -->
                                                <Label
                                                    Grid.Column="1"
                                                    Text="Papers"
                                                    FontSize="Medium"
                                                    TextColor="White"
                                                    VerticalTextAlignment="Center"
                                                    HorizontalTextAlignment="Start"
                                                    FontFamily="ItimRegular"/>
                                            
                                                <!-- Move -->
                                                <Button
                                                     Grid.Column="2"
                                                     CornerRadius="5"
                                                     HeightRequest="30"
                                                     Padding="0"
                                                     ImageSource="move_item"
                                                     BackgroundColor="Transparent"/>
                                            
                                                <!-- delete -->
                                                <Button
                                                  Grid.Column="3"
                                                  CornerRadius="5"
                                                  Padding="0"
                                                  BackgroundColor="Transparent">
                                                    <Button.ImageSource >
                                                        <FontImageSource 
                                                          FontFamily="FluentIcons" 
                                                          Color="{StaticResource Primary}"
                                                          Glyph="{x:Static local:IconNames.Delete}"/>
                                                    </Button.ImageSource>
                                                </Button>

                                            </Grid>
                                        </Border>
                                    </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Item 1</x:String>
                                        <x:String>Item 2</x:String>
                                        <x:String>Item 3</x:String>
                                        <x:String>Item 4</x:String>
                                        <x:String>Item 5</x:String>
                                        <x:String>Item 6</x:String>
                                        <x:String>Item 7</x:String>
                                        <x:String>Item 8</x:String>
                                        <x:String>Item 9</x:String>
                                        <x:String>Item 10</x:String>
                                        <x:String>Item 11</x:String>
                                        <x:String>Item 12</x:String>
                                        <x:String>Item 13</x:String>
                                        <x:String>Item 14</x:String>
                                        <x:String>Item 15</x:String>
                                </x:Array>
                                </CollectionView.ItemsSource>
                            </CollectionView>
                        <BoxView 
                         HeightRequest="2"
                         Color="{StaticResource Yellow}"/>
                </StackLayout>

                <!-- add button -->
                <Button
                 Grid.Row="3"
                 Margin="0,15,15,15"
                 HorizontalOptions="End"
                 VerticalOptions="End"
                 CornerRadius="50"
                 Padding="10"
                 Command="{Binding AddItemCommand}"
                 BackgroundColor="{StaticResource Primary}">
                    <Button.Shadow>
                        <Shadow
                         Brush="{StaticResource Primary}"
                         Opacity="0.5"
                         Offset="0,0"
                         Radius="10"/>
                    </Button.Shadow>
                    <Button.ImageSource >
                        <FontImageSource 
                         FontFamily="FluentIcons" 
                         Color="{StaticResource Black}"
                         Glyph="{x:Static local:IconNames.Plus}"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Grid>
    </views:BaseView.Content>
</views:BaseView>


           
