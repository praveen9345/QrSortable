<?xml version="1.0" encoding="UTF-8"?>
<views:BaseView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QrSortable.Components.UiFunctionality.Navigation.Views;assembly=QrSortable"
    xmlns:local="clr-namespace:QrSortable.Resources"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="QrSortable.Components.CoreFeatures.Scanner.Views.BoxDetailView"
    BackgroundImageSource ="background_layout.webp">
    <views:BaseView.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="BoolInverter" />
        </ResourceDictionary>
    </views:BaseView.Resources>
    <views:BaseView.Content>
        <Grid>
             <Grid.RowDefinitions>
                    <!-- back -->
                    <RowDefinition Height="Auto"></RowDefinition>
                    <!-- Camera view -->
                    <RowDefinition Height="*"></RowDefinition>

             </Grid.RowDefinitions>

                <!-- Back button -->
                <Button
                    Grid.Row="0"
                    Margin="15,15,0,0"
                    Command="{Binding BackNavigationCommand}"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    BackgroundColor="{StaticResource DarkGrey}"
                    CornerRadius="5"
                    Padding="2">
                    <Button.Shadow>
                        <Shadow
                        Brush="Black"
                        Opacity="0.5"
                        Offset="0,0"
                        Radius="10"/>
                    </Button.Shadow>
                    <Button.ImageSource >
                        <FontImageSource 
                        FontFamily="FluentIcons" 
                        Color="{StaticResource Primary}"
                        Glyph="{x:Static local:IconNames.Back}"/>
                    </Button.ImageSource>
                </Button>

                <Image
                    Margin="0,-15,0,0"
                    Source="box"
                    Aspect="AspectFit"
                    HeightRequest="180"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
                <Label
                     FontSize="40"
                     Margin="0,110,0,0"
                     TextTransform="Uppercase"
                     FontAttributes="Bold"
                     FontFamily="ItimRegular"
                     Text="{Binding Barcode}" 
                     TextColor="{StaticResource Red}"
                     BackgroundColor="Transparent"
                     HorizontalTextAlignment="Center"/>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <!-- location -->
                        <RowDefinition Height="Auto"></RowDefinition>
                        <!-- category -->
                        <RowDefinition Height="Auto"></RowDefinition>
                        <!-- items -->
                        <RowDefinition Height="*"></RowDefinition>
                        <!-- add button -->
                        <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>

                    <StackLayout 
                        Grid.Row="0"
                        Margin="20,0,20,0"
                        Orientation="Horizontal">
                        <!-- location  -->
                        <Image           
                            HeightRequest="50"
                            WidthRequest="50"
                            Source="location"
                            Aspect="AspectFit"/>
                        
                        <!-- location  -->
                        <Label
                          Text="{Binding  LocationText}"               
                          FontAttributes="Bold"
                          FontFamily="ItimRegular"
                          FontSize="25"
                          TextColor="{StaticResource White}"
                          BackgroundColor="Transparent"
                          HorizontalTextAlignment="Center"
                          VerticalTextAlignment="Center"
                          IsVisible="{Binding IsNewBarcode}"/>

                        <!-- Placeholder for location input field -->
                        <Border 
                             Margin="10"
                             Background="{StaticResource DarkGrey}"
                             StrokeShape="RoundRectangle 10"
                             HorizontalOptions="FillAndExpand"
                             IsVisible="{Binding IsNewBarcode, Converter={StaticResource BoolInverter}}">
                            <Border.Shadow>
                                <Shadow
                                Brush="Black"
                                Opacity="0.5"
                                Offset="0,0"
                                Radius="10"/>
                            </Border.Shadow>
                            <Grid >
                                <!-- input field -->
                                <Entry
                                    Margin="10,0,0,0"
                                    Placeholder="location ..." 
                                    Text="{Binding Location}"
                                    Style="{StaticResource NormalText}"/>
                        </Grid>
                        </Border>
                    </StackLayout>

                    <StackLayout 
                     Grid.Row="1"
                     Margin="20,0,20,0"
                     Orientation="Horizontal">
                        <!-- Category  -->
                        <Label
                            Text="{Binding  CategoryText}"               
                            FontAttributes="Bold"
                            FontFamily="ItimRegular"
                            FontSize="20"
                            Margin="0,5,0,5"
                            TextColor="{StaticResource White}"
                            BackgroundColor="Transparent"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>

                        <!-- Placeholder for category input field -->
                        <Border 
                             Margin="10"
                             Background="{StaticResource DarkGrey}"
                             StrokeShape="RoundRectangle 10"
                             HorizontalOptions="FillAndExpand"
                             IsVisible="{Binding IsNewBarcode, Converter={StaticResource BoolInverter}}">
                            <Border.Shadow>
                                <Shadow
                                 Brush="Black"
                                 Opacity="0.5"
                                 Offset="0,0"
                                 Radius="10"/>
                                </Border.Shadow>
                            <!-- input field -->
                            <Grid >
                                <Entry
                                 Margin="10,0,0,0"
                                 Placeholder="category ..." 
                                 Text="{Binding Category}"
                                 Style="{StaticResource NormalText}"/>
                            </Grid>
                        </Border>
                    </StackLayout>

                    <StackLayout
                     Grid.Row="2"
                     Background="{StaticResource DarkGrey}">
                         <!-- seprator -->
                         <BoxView 
                         HeightRequest="2"
                         Color="{StaticResource Yellow}"/>
                          <!-- collection view -->
                         <CollectionView 
                             SelectionMode="Single"
                             VerticalOptions="FillAndExpand"
                             ItemsSource="{Binding Items}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="5">
                                    <!-- Box view -->
                                    <Border 
                                            Background="{StaticResource DarkGrey}"
                                            StrokeShape="RoundRectangle 10"
                                            HorizontalOptions="FillAndExpand">
                                        <Border.Shadow>
                                            <Shadow
                                                   Brush="Black"
                                                   Opacity="0.5"
                                                   Offset="0,0"
                                                   Radius="8"/>
                                        </Border.Shadow>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="7*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- first item image -->
                                            <Image
                                                   Grid.Column="0"
                                                   HeightRequest="40"
                                                   WidthRequest="40"
                                                   Source="{Binding ImageSource}"
                                                   Aspect="AspectFit"/>

                                            <!-- Label -->
                                            <Label
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    Text="{Binding ItemName}"
                                                    FontSize="Medium"
                                                    TextColor="White"
                                                    VerticalTextAlignment="Center"
                                                    HorizontalTextAlignment="Start"
                                                    FontFamily="ItimRegular"/>

                                            <!-- Move -->
                                            <Button
                                                     Grid.Column="2"
                                                     CornerRadius="5"
                                                     HeightRequest="30"
                                                     Padding="0"
                                                     ImageSource="move_item"
                                                     BackgroundColor="Transparent"/>

                                            <!-- delete -->
                                            <Button
                                                  Grid.Column="3"
                                                  CornerRadius="5"
                                                  Padding="0"
                                                  BackgroundColor="Transparent">
                                                <Button.ImageSource >
                                                    <FontImageSource 
                                                          FontFamily="FluentIcons" 
                                                          Color="{StaticResource Primary}"
                                                          Glyph="{x:Static local:IconNames.Delete}"/>
                                                </Button.ImageSource>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                        <BoxView 
                         HeightRequest="2"
                         Color="{StaticResource Yellow}"/>
                </StackLayout>

                <!-- add button -->
                <Button
                 Grid.Row="3"
                 Margin="0,15,15,15"
                 HorizontalOptions="End"
                 VerticalOptions="End"
                 CornerRadius="50"
                 Padding="10"
                 Command="{Binding AddItemCommand}"
                 BackgroundColor="{StaticResource Primary}">
                    <Button.Shadow>
                        <Shadow
                         Brush="{StaticResource Primary}"
                         Opacity="0.5"
                         Offset="0,0"
                         Radius="10"/>
                    </Button.Shadow>
                    <Button.ImageSource >
                        <FontImageSource 
                         FontFamily="FluentIcons" 
                         Color="{StaticResource Black}"
                         Glyph="{x:Static local:IconNames.Plus}"/>
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Grid>
    </views:BaseView.Content>
</views:BaseView>


           
