<?xml version="1.0" encoding="UTF-8"?>
<views:BaseView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QrSortable.Components.UiFunctionality.Navigation.Views;assembly=QrSortable"
    xmlns:local="clr-namespace:QrSortable.Resources"
    x:Class="QrSortable.Components.CoreFeatures.CodeGenerator.Views.CodeGeneratorView"
    BackgroundImageSource ="background_layout.webp">
    <views:BaseView.Content>
        <Grid>
            <!-- Back button -->
            <Button
              Grid.Row="0"
              Margin="15,15,0,0"
              Command="{Binding BackNavigationCommand}"
              HorizontalOptions="Start"
              VerticalOptions="Start"
              BackgroundColor="{StaticResource DarkGrey}"
              CornerRadius="5"
              Padding="2">
                <Button.Shadow>
                    <Shadow
                  Brush="Black"
                  Opacity="0.5"
                  Offset="0,0"
                  Radius="10"/>
                </Button.Shadow>
                <Button.ImageSource >
                    <FontImageSource 
                  FontFamily="FluentIcons" 
                  Color="{StaticResource Primary}"
                  Glyph="{x:Static local:IconNames.Back}"/>
                </Button.ImageSource>
            </Button>
            
            
        </Grid> 
    </views:BaseView.Content>
</views:BaseView>


           
