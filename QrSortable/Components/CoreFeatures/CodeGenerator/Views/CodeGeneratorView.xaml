<?xml version="1.0" encoding="UTF-8" ?>
<views:BaseView x:Class="QrSortable.Components.CoreFeatures.CodeGenerator.Views.CodeGeneratorView"
                xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:local="clr-namespace:QrSortable.Resources"
                xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                xmlns:views="clr-namespace:QrSortable.Components.UiFunctionality.Navigation.Views;assembly=QrSortable"
                BackgroundImageSource="background_layout.webp">
    <views:BaseView.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="170" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Margin="15,15,0,0"
                    Padding="2"
                    BackgroundColor="{StaticResource DarkGrey}"
                    Command="{Binding BackNavigationCommand}"
                    CornerRadius="5"
                    HorizontalOptions="Start"
                    VerticalOptions="Start">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.5" Radius="10" Offset="0,0" />
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource FontFamily="FluentIcons"
                                     Glyph="{x:Static local:IconNames.Back}"
                                     Color="{StaticResource Primary}" />
                </Button.ImageSource>
            </Button>

            <Image Grid.Row="1"
                   Margin="0,0,0,10"
                   Aspect="AspectFit"
                   HeightRequest="170"
                   HorizontalOptions="Center"
                   Source="{Binding DemoImage}"
                   VerticalOptions="Center" />

            <ScrollView Grid.Row="2" Margin="0,10,0,0">
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <Label Margin="15,0,15,0"
                               FontAttributes="Bold"
                               FontFamily="ItimRegular"
                               FontSize="18"
                               Text="Code:"
                               TextColor="{StaticResource White}" />

                        <CollectionView Margin="15,0,15,0"
                                        SelectedItem="{Binding SelectedCode, Mode=TwoWay}"
                                        SelectionChangedCommand="{Binding OnSelectionCodeChangedCommand}"
                                        SelectionMode="Single"
                                        HeightRequest="65">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="15" Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>QR code</x:String>
                                    <x:String>Bar code</x:String>
                                </x:Array>
                            </CollectionView.ItemsSource>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="25,0"
                                            BackgroundColor="Transparent"
                                            Stroke="{StaticResource Primary}"
                                            StrokeShape="RoundRectangle 25"
                                            StrokeThickness="2"
                                            StrokeLineJoin="Round"
                                            MinimumWidthRequest="120"
                                            HeightRequest="50"
                                            VerticalOptions="Center">
                                        <Label FontAttributes="Bold"
                                               FontFamily="ItimRegular"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Text="{Binding .}"
                                               TextColor="White" />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Margin="15,0,15,0"
                               FontAttributes="Bold"
                               FontFamily="ItimRegular"
                               FontSize="18"
                               Text="Page:"
                               TextColor="{StaticResource White}" />

                        <CollectionView Margin="15,0,15,0"
                                        ItemsSource="{Binding PageSelected}"
                                        SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        HeightRequest="65">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="15" Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="20,0"
                                            BackgroundColor="Transparent"
                                            Stroke="{StaticResource Primary}"
                                            StrokeShape="RoundRectangle 25"
                                            StrokeThickness="2"
                                            StrokeLineJoin="Round"
                                            MinimumWidthRequest="130"
                                            HeightRequest="50"
                                            VerticalOptions="Center">
                                        <Label FontAttributes="Bold"
                                               FontFamily="ItimRegular"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Text="{Binding .}"
                                               TextColor="White" />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <StackLayout Margin="15,0,15,0" Orientation="Horizontal">
                        <Label FontAttributes="Bold"
                               FontFamily="ItimRegular"
                               FontSize="18"
                               Text="Tag Name:"
                               TextColor="{StaticResource White}"
                               VerticalTextAlignment="Center" />
                        <Border Margin="10,0,0,0"
                                Padding="5,5"
                                Background="{StaticResource DarkGrey}"
                                HorizontalOptions="FillAndExpand"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.5" Radius="10" Offset="0,0" />
                            </Border.Shadow>
                            <Entry Margin="10,0,0,0"
                                   Placeholder="e.g. Kitchen"
                                   PlaceholderColor="{StaticResource PlaceholderColor}"
                                   Style="{StaticResource NormalText}"
                                   Text="{Binding TagName}" />
                        </Border>
                    </StackLayout>

                    <StackLayout Margin="15,0,15,0"
                                 IsVisible="{Binding ColorVisible}"
                                 Orientation="Horizontal">
                        <Label FontAttributes="Bold"
                               FontFamily="ItimRegular"
                               FontSize="18"
                               Text="Color Hex:"
                               TextColor="{StaticResource White}"
                               VerticalTextAlignment="Center" />
                        <Border Margin="10,0,0,0"
                                Padding="5,5"
                                Background="{StaticResource DarkGrey}"
                                HorizontalOptions="FillAndExpand"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.5" Radius="10" Offset="0,0" />
                            </Border.Shadow>
                            <Entry Margin="10,0,0,0"
                                   Placeholder="e.g. #000000"
                                   PlaceholderColor="{StaticResource PlaceholderColor}"
                                   Style="{StaticResource NormalText}"
                                   Text="{Binding HexCode}" />
                        </Border>
                    </StackLayout>

                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Label Margin="15,0,0,0"
                               FontAttributes="Bold"
                               FontFamily="ItimRegular"
                               FontSize="18"
                               Text="No. of Pages:"
                               TextColor="{StaticResource White}"
                               VerticalTextAlignment="Center" />
                        <Border Padding="0"
                                Background="{StaticResource Primary}"
                                HeightRequest="50"
                                StrokeShape="RoundRectangle 25"
                                VerticalOptions="Center"
                                WidthRequest="180">
                            <Grid HorizontalOptions="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" BackgroundColor="Transparent" Command="{Binding DecreaseQuantityCommand}">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FluentIcons" Glyph="{x:Static local:IconNames.Minus}" Color="Black" Size="22" />
                                    </Button.ImageSource>
                                </Button>
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="26" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Text="{Binding PageCount}" TextColor="Black" />
                                <Button Grid.Column="2" BackgroundColor="Transparent" Command="{Binding IncreaseQuantityCommand}">
                                    <Button.ImageSource>
                                        <FontImageSource FontFamily="FluentIcons" Glyph="{x:Static local:IconNames.Plus}" Color="Black" Size="22" />
                                    </Button.ImageSource>
                                </Button>
                            </Grid>
                        </Border>
                    </HorizontalStackLayout>

                    <StackLayout HorizontalOptions="Center" Orientation="Horizontal">
                        <Label FontAttributes="Bold" FontSize="24" Text="Total:" TextColor="{StaticResource Primary}" />
                        <Label Margin="10,0,0,0" FontAttributes="Bold" FontSize="28" Text="{Binding TotalAmount}" TextColor="{StaticResource Primary}" />
                    </StackLayout>

                    <Button Margin="20,0,20,20"
                            BackgroundColor="{StaticResource Primary}"
                            Command="{Binding BuyNowCommand}"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="Buy Now"
                            TextColor="Black">
                        <Button.Shadow>
                            <Shadow Brush="Black" Opacity="0.3" Radius="10" Offset="5,5" />
                        </Button.Shadow>
                    </Button>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </views:BaseView.Content>
</views:BaseView>