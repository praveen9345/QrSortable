<?xml version="1.0" encoding="UTF-8" ?>
<views:BaseView
    x:Class="QrSortable.Components.CoreFeatures.CodeGenerator.Views.PaperProductView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QrSortable.Resources"
    xmlns:localization="clr-namespace:QrSortable.Components.UiFunctionality.Localization"
    xmlns:views="clr-namespace:QrSortable.Components.UiFunctionality.Navigation.Views;assembly=QrSortable"
    BackgroundImageSource="background_layout.png">
    <views:BaseView.Content>
        <ScrollView>
            <Grid>
                <Grid.RowDefinitions>
                    <!--  back  -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{OnIdiom Phone=320, Tablet=600}" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Back button  -->
                <Button
                    Grid.Row="0"
                    Margin="15,15,0,0"
                    Padding="2"
                    BackgroundColor="{StaticResource DarkGrey}"
                    Command="{Binding BackNavigationCommand}"
                    CornerRadius="5"
                    HorizontalOptions="Start"
                    VerticalOptions="Start">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.5"
                            Radius="10"
                            Offset="0,0" />
                    </Button.Shadow>
                    <Button.ImageSource>
                        <FontImageSource
                            FontFamily="FluentIcons"
                            Glyph="{x:Static local:IconNames.Back}"
                            Color="{StaticResource Primary}" />
                    </Button.ImageSource>
                </Button>

                <!--  cart order view  -->
                <Grid
                    Grid.Row="0"
                    Padding="5"
                    BackgroundColor="Transparent"
                    HeightRequest="80"
                    HorizontalOptions="End"
                    WidthRequest="80">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCartTapped" />
                    </Grid.GestureRecognizers>

                    <!--  Cart Icon  -->
                    <Image
                        HeightRequest="35"
                        HorizontalOptions="Center"
                        Source="cart_yellow_icon"
                        VerticalOptions="Center"
                        WidthRequest="35" />

                    <!--  Item Count  -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="25"
                        HorizontalOptions="Center"
                        Text="{Binding BasketCount}"
                        TextColor="White"
                        VerticalOptions="Start" />
                </Grid>

                <!--  Product title and discription  -->
                <Grid Grid.Row="1" Margin="10,-15,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>
                    <!--  Title  -->
                    <Label
                        Grid.Row="0"
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="Large"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Title}"
                        TextColor="{StaticResource Primary}"
                        VerticalTextAlignment="Start" />
                    <!--  Discription  -->
                    <Label
                        Grid.Row="1"
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="Medium"
                        HorizontalTextAlignment="Start"
                        Text="{Binding Discription}"
                        TextColor="{StaticResource White}"
                        VerticalTextAlignment="Start" />
                </Grid>

                <Grid Grid.Row="2" Background="{StaticResource DarkGrey}">
                    <!--  seprator  -->
                    <BoxView
                        HeightRequest="2"
                        VerticalOptions="Start"
                        Color="{StaticResource Yellow}" />
                    <!--  Carousel View  -->
                    <CarouselView
                        BackgroundColor="Transparent"
                        ItemsSource="{Binding ImageArray}"
                        Loop="False"
                        VerticalOptions="Fill">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <!--  boxes view  -->
                                <Grid Margin="5">
                                    <!--  images  -->
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="{OnIdiom Phone=320,
                                                                Tablet=600}"
                                        HorizontalOptions="Start"
                                        Rotation="{Binding Rotate}"
                                        Source="{Binding Image}"
                                        VerticalOptions="Start" />

                                    <!--  Swipe view  -->
                                    <Button
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        CornerRadius="50"
                                        HeightRequest="30"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        WidthRequest="30">
                                        <Button.ImageSource>
                                            <FontImageSource
                                                FontFamily="FluentIcons"
                                                Glyph="{x:Static local:IconNames.Swipe}"
                                                Color="{StaticResource Yellow}" />
                                        </Button.ImageSource>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                    <!--  seprator  -->
                    <BoxView
                        HeightRequest="2"
                        VerticalOptions="End"
                        Color="{StaticResource Yellow}" />
                </Grid>

                <HorizontalStackLayout
                    Grid.Row="3"
                    Margin="10,10,10,5"
                    Spacing="10"
                    VerticalOptions="Center">

                    <!--  Quantity Label  -->
                    <Label
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="20"
                        Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaperProductViewModel_Quantity]}"
                        TextColor="{StaticResource White}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />

                    <!--  Plus / Minus Container  -->
                    <Border
                        Padding="0"
                        Background="{StaticResource Primary}"
                        HeightRequest="50"
                        HorizontalOptions="FillAndExpand"
                        StrokeShape="RoundRectangle 30"
                        VerticalOptions="Center"
                        WidthRequest="200">

                        <Grid
                            Padding="10,0"
                            ColumnSpacing="0"
                            VerticalOptions="Center">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Minus Button  -->
                            <Button
                                Grid.Column="0"
                                Padding="0"
                                BackgroundColor="Transparent"
                                Command="{Binding DecreaseQuantityCommand}"
                                CornerRadius="20"
                                HeightRequest="40"
                                VerticalOptions="Center"
                                WidthRequest="40">

                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="FluentIcons"
                                        Glyph="{x:Static local:IconNames.Minus}"
                                        Size="18"
                                        Color="Black" />
                                </Button.ImageSource>
                            </Button>

                            <!--  Quantity  -->
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="22"
                                HorizontalTextAlignment="Center"
                                Text="{Binding ProductCount}"
                                TextColor="Black"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />

                            <!--  Plus Button  -->
                            <Button
                                Grid.Column="2"
                                Padding="0"
                                BackgroundColor="Transparent"
                                Command="{Binding IncreaseQuantityCommand}"
                                CornerRadius="20"
                                HeightRequest="40"
                                VerticalOptions="Center"
                                WidthRequest="40">

                                <Button.ImageSource>
                                    <FontImageSource
                                        FontFamily="FluentIcons"
                                        Glyph="{x:Static local:IconNames.Plus}"
                                        Size="18"
                                        Color="Black" />
                                </Button.ImageSource>
                            </Button>

                        </Grid>
                    </Border>

                    <!--  Total Amount  -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="26"
                        Text="{Binding TotalAmount}"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />

                </HorizontalStackLayout>

                <Label
                    Grid.Row="4"
                    FontFamily="ItimRegular"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[Dialog_CurrencyCanBeSelectedText]}"
                    TextColor="Red" />

                <!--  add to basket  -->
                <Button
                    Grid.Row="5"
                    Margin="20,5,20,5"
                    BackgroundColor="{StaticResource Primary}"
                    Command="{Binding AddToBasketCommand}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="ItimRegular"
                    FontSize="20"
                    HorizontalOptions="Fill"
                    Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaperProductViewModel_Basket]}"
                    TextColor="Black"
                    VerticalOptions="Center">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.3"
                            Radius="10"
                            Offset="5,5" />
                    </Button.Shadow>
                </Button>

                <!--  buy now  -->
                <Button
                    Grid.Row="6"
                    Margin="20,5,20,10"
                    BackgroundColor="{StaticResource Primary}"
                    Command="{Binding BuyNowCommand}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontFamily="ItimRegular"
                    FontSize="20"
                    HorizontalOptions="Fill"
                    Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaperProductViewModel_BuyText]}"
                    TextColor="Black"
                    VerticalOptions="Center">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.3"
                            Radius="10"
                            Offset="5,5" />
                    </Button.Shadow>
                </Button>
            </Grid>
        </ScrollView>
    </views:BaseView.Content>
</views:BaseView>
