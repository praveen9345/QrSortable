<?xml version="1.0" encoding="UTF-8" ?>
<views:BaseView
    x:Class="QrSortable.Components.CoreFeatures.OrdersPayments.Views.PaymentShipmentView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QrSortable.Resources"
    xmlns:localization="clr-namespace:QrSortable.Components.UiFunctionality.Localization"
    xmlns:views="clr-namespace:QrSortable.Components.UiFunctionality.Navigation.Views;assembly=QrSortable"
    BackgroundImageSource="background_layout.webp">
    <views:BaseView.Content>
        <Grid>
            <Grid.RowDefinitions>
                <!--  back  -->
                <RowDefinition Height="Auto" />
                <!--  item view  -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Back button  -->
            <Button
                Grid.Row="0"
                Margin="15,15,0,0"
                Padding="2"
                BackgroundColor="{StaticResource DarkGrey}"
                Command="{Binding BackNavigationCommand}"
                CornerRadius="5"
                HorizontalOptions="Start"
                VerticalOptions="Start">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.5"
                        Radius="10"
                        Offset="0,0" />
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FluentIcons"
                        Glyph="{x:Static local:IconNames.Back}"
                        Color="{StaticResource Primary}" />
                </Button.ImageSource>
            </Button>

            <!--  page icon  -->
            <Image
                Grid.Row="0"
                Margin="0,-15,0,-10"
                Aspect="AspectFit"
                HeightRequest="110"
                HorizontalOptions="Center"
                Source="payment"
                VerticalOptions="Center" />

            <ScrollView Grid.Row="1">
                <StackLayout Margin="10,0,0,10">

                    <!--  Product Title  -->
                    <Label
                        Margin="0,0,0,5"
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="23"
                        HorizontalTextAlignment="Center"
                        Text="{Binding ProductTitle}"
                        TextColor="{StaticResource White}"
                        VerticalTextAlignment="Center" />

                    <!--  Shipping and Billing Address view  -->
                    <Label
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="22"
                        HorizontalTextAlignment="Start"
                        Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_ShipAndBillAddressText]}"
                        TextColor="{StaticResource Primary}"
                        VerticalTextAlignment="Center" />

                    <!--  Person name view  -->
                    <StackLayout
                        Grid.Row="0"
                        Margin="15,0,15,0"
                        Orientation="Horizontal">
                        <Label
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontFamily="ItimRegular"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_NameText]}"
                            TextColor="{StaticResource White}"
                            VerticalTextAlignment="Center" />
                        <Border
                            Margin="10,0,0,0"
                            Padding="5,5"
                            Background="{StaticResource DarkGrey}"
                            HorizontalOptions="FillAndExpand"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.5"
                                    Radius="10"
                                    Offset="0,0" />
                            </Border.Shadow>
                            <Grid>
                                <Entry
                                    Margin="10,0,0,0"
                                    Placeholder="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_EnterNameText]}"
                                    PlaceholderColor="{StaticResource PlaceholderColor}"
                                    Style="{StaticResource NormalText}"
                                    Text="{Binding Name}" />
                            </Grid>
                        </Border>
                    </StackLayout>

                    <!--  Street name view  -->
                    <StackLayout
                        Grid.Row="0"
                        Margin="15,10,15,0"
                        Orientation="Horizontal">
                        <Label
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontFamily="ItimRegular"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_StreetText]}"
                            TextColor="{StaticResource White}"
                            VerticalTextAlignment="Center" />
                        <Border
                            Margin="10,0,0,0"
                            Padding="5,5"
                            Background="{StaticResource DarkGrey}"
                            HorizontalOptions="FillAndExpand"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.5"
                                    Radius="10"
                                    Offset="0,0" />
                            </Border.Shadow>
                            <Grid>
                                <Entry
                                    Margin="10,0,0,0"
                                    Placeholder="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_EnterStreetPlaceText]}"
                                    PlaceholderColor="{StaticResource PlaceholderColor}"
                                    Style="{StaticResource NormalText}"
                                    Text="{Binding StreetName}" />
                            </Grid>
                        </Border>
                    </StackLayout>

                    <!--  House number view  -->
                    <StackLayout
                        Grid.Row="0"
                        Margin="15,10,15,0"
                        Orientation="Horizontal">
                        <Label
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontFamily="ItimRegular"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_HouseNoText]}"
                            TextColor="{StaticResource White}"
                            VerticalTextAlignment="Center" />
                        <Border
                            Margin="10,0,0,0"
                            Padding="5,5"
                            Background="{StaticResource DarkGrey}"
                            HorizontalOptions="FillAndExpand"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.5"
                                    Radius="10"
                                    Offset="0,0" />
                            </Border.Shadow>
                            <Grid>
                                <Entry
                                    Margin="10,0,0,0"
                                    Keyboard="Numeric"
                                    Placeholder="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_EnterHouseNoPlaceText]}"
                                    PlaceholderColor="{StaticResource PlaceholderColor}"
                                    Style="{StaticResource NormalText}"
                                    Text="{Binding HouseNumber}" />
                            </Grid>
                        </Border>
                    </StackLayout>

                    <!--  Postal code view  -->
                    <StackLayout
                        Grid.Row="0"
                        Margin="15,10,15,0"
                        Orientation="Horizontal">
                        <Label
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontFamily="ItimRegular"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_ZIPText]}"
                            TextColor="{StaticResource White}"
                            VerticalTextAlignment="Center" />
                        <Border
                            Margin="10,0,0,0"
                            Padding="5,5"
                            Background="{StaticResource DarkGrey}"
                            HorizontalOptions="FillAndExpand"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.5"
                                    Radius="10"
                                    Offset="0,0" />
                            </Border.Shadow>
                            <Grid>
                                <Entry
                                    Margin="10,0,0,0"
                                    Placeholder="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_ZIPPlaceText]}"
                                    PlaceholderColor="{StaticResource PlaceholderColor}"
                                    Style="{StaticResource NormalText}"
                                    Text="{Binding ZipCode}" />
                            </Grid>
                        </Border>
                    </StackLayout>

                    <!--  City view  -->
                    <StackLayout
                        Grid.Row="0"
                        Margin="15,10,15,0"
                        Orientation="Horizontal">
                        <Label
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontFamily="ItimRegular"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_CityText]}"
                            TextColor="{StaticResource White}"
                            VerticalTextAlignment="Center" />
                        <Border
                            Margin="10,0,0,0"
                            Padding="5,5"
                            Background="{StaticResource DarkGrey}"
                            HorizontalOptions="FillAndExpand"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.5"
                                    Radius="10"
                                    Offset="0,0" />
                            </Border.Shadow>
                            <Grid>
                                <Entry
                                    Margin="10,0,0,0"
                                    Placeholder="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_CityPlaceText]}"
                                    PlaceholderColor="{StaticResource PlaceholderColor}"
                                    Style="{StaticResource NormalText}"
                                    Text="{Binding CityName}" />
                            </Grid>
                        </Border>
                    </StackLayout>

                    <!--  Country picker view (replaces Entry)  -->
                    <StackLayout
                        Grid.Row="0"
                        Margin="15,10,15,0"
                        Orientation="Horizontal">
                        <Label
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontFamily="ItimRegular"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_CountryText]}"
                            TextColor="{StaticResource White}"
                            VerticalTextAlignment="Center" />
                        <Border
                            Margin="10,0,0,0"
                            Padding="5,5"
                            Background="{StaticResource DarkGrey}"
                            HorizontalOptions="FillAndExpand"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.5"
                                    Radius="10"
                                    Offset="0,0" />
                            </Border.Shadow>
                            <Picker
                                Title="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_CountryPlaceText]}"
                                Margin="10,0,10,0"
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                ItemsSource="{Binding CountryList}"
                                SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                                TextColor="{StaticResource White}"
                                TitleColor="{StaticResource PlaceholderColor}" />
                        </Border>
                    </StackLayout>

                    <!--  Email view  -->
                    <StackLayout
                        Grid.Row="0"
                        Margin="15,10,15,0"
                        Orientation="Horizontal">
                        <Label
                            BackgroundColor="Transparent"
                            FontAttributes="Bold"
                            FontFamily="ItimRegular"
                            FontSize="18"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_EmailText]}"
                            TextColor="{StaticResource White}"
                            VerticalTextAlignment="Center" />
                        <Border
                            Margin="10,0,0,0"
                            Padding="5,5"
                            Background="{StaticResource DarkGrey}"
                            HorizontalOptions="FillAndExpand"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.5"
                                    Radius="10"
                                    Offset="0,0" />
                            </Border.Shadow>
                            <Grid>
                                <Entry
                                    Margin="10,0,0,0"
                                    Keyboard="Email"
                                    Placeholder="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_EmailPlaceText]}"
                                    PlaceholderColor="{StaticResource PlaceholderColor}"
                                    Style="{StaticResource NormalText}"
                                    Text="{Binding Email}" />
                            </Grid>
                        </Border>
                    </StackLayout>

                    <!--  Currency selector  -->
                    <StackLayout
                        Grid.Row="0"
                        Margin="15,20,15,0"
                        HorizontalOptions="Start"
                        Orientation="Horizontal">

                        <!--  for Android  -->
                        <CollectionView
                            IsVisible="{OnPlatform iOS='false',
                                                   Android='true'}"
                            ItemsSource="{Binding CurrencyItem}"
                            SelectedItem="{Binding SelectedCurrencyItem, Mode=TwoWay}"
                            SelectionMode="Single">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="10"
                                        Stroke="{StaticResource Primary}"
                                        StrokeShape="RoundRectangle 30"
                                        StrokeThickness="2">
                                        <Label
                                            FontAttributes="Bold"
                                            FontFamily="ItimRegular"
                                            FontSize="16"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding .}"
                                            TextColor="White"
                                            VerticalOptions="Center" />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                        <Setter Property="StrokeThickness" Value="2" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!--  for iOS  -->
                        <CollectionView
                            x:Name="IOSCollectionView"
                            Margin="15,0,15,0"
                            HeightRequest="50"
                            IsVisible="{OnPlatform iOS='true',
                                                   Android='false'}"
                            ItemsSource="{Binding CurrencyItem}"
                            SelectedItem="{Binding SelectedCurrencyItem, Mode=TwoWay}"
                            SelectionMode="Single">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="8" Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame
                                        Padding="2"
                                        BorderColor="{StaticResource Primary}"
                                        CornerRadius="18"
                                        HasShadow="False"
                                        HeightRequest="40"
                                        WidthRequest="80">
                                        <Label
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            Text="{Binding .}"
                                            TextColor="White"
                                            VerticalOptions="Center" />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

                    <!--  Pricing breakdown card  -->
                    <Border
                        Margin="15,20,15,0"
                        Padding="15"
                        Background="{StaticResource DarkGrey}"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0">
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.4"
                                Radius="10"
                                Offset="0,0" />
                        </Border.Shadow>
                        <StackLayout Spacing="0">

                            <!--  Subtotal row  -->
                            <StackLayout Margin="5,5,5,10" Orientation="Horizontal">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="ItimRegular"
                                    FontSize="18"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_SubtotalText]}"
                                    TextColor="{StaticResource White}"
                                    VerticalTextAlignment="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="ItimRegular"
                                    FontSize="18"
                                    HorizontalOptions="End"
                                    Text="{Binding SubtotalAmount}"
                                    TextColor="{StaticResource White}"
                                    VerticalTextAlignment="Center" />
                            </StackLayout>

                            <!--  Shipping cost row  -->
                            <StackLayout Margin="5,0,5,10" Orientation="Horizontal">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="ItimRegular"
                                    FontSize="18"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_ShippingCostText]}"
                                    TextColor="{StaticResource White}"
                                    VerticalTextAlignment="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="ItimRegular"
                                    FontSize="18"
                                    HorizontalOptions="End"
                                    Text="{Binding ShippingCostDisplay}"
                                    TextColor="{StaticResource Primary}"
                                    VerticalTextAlignment="Center" />
                            </StackLayout>

                            <!--  Divider  -->
                            <BoxView
                                Margin="5,0,5,10"
                                HeightRequest="1"
                                Opacity="0.3"
                                Color="{StaticResource White}" />

                            <!--  Grand total row  -->
                            <StackLayout Margin="5,0,5,5" Orientation="Horizontal">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="ItimRegular"
                                    FontSize="24"
                                    HorizontalOptions="StartAndExpand"
                                    Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_Total]}"
                                    TextColor="{StaticResource Primary}"
                                    VerticalTextAlignment="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="ItimRegular"
                                    FontSize="28"
                                    HorizontalOptions="End"
                                    Text="{Binding TotalAmount}"
                                    TextColor="{StaticResource Primary}"
                                    VerticalTextAlignment="Center" />
                            </StackLayout>

                        </StackLayout>
                    </Border>

                    <!--  Payment status message  -->
                    <Label
                        Margin="10,10,10,0"
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="Large"
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding IsPaymentMessageVisible}"
                        Text="{Binding PaymentStatusMessage}"
                        TextColor="{StaticResource Red}"
                        VerticalTextAlignment="Center" />

                    <!--  Pay by Card button  -->
                    <Button
                        Margin="10,20,20,0"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding PaymentByCardCommand}"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="20"
                        HorizontalOptions="FillAndExpand"
                        Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_CardPayment]}"
                        TextColor="Black"
                        VerticalOptions="Center">
                        <Button.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.3"
                                Radius="10"
                                Offset="5,5" />
                        </Button.Shadow>
                    </Button>

                    <!--  Pay by Bank Transfer button  -->
                    <Button
                        Margin="10,20,20,0"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding PaymentByBankCommand}"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontFamily="ItimRegular"
                        FontSize="20"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding BankTransferVisible}"
                        Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_BankTransfer]}"
                        TextColor="Black"
                        VerticalOptions="Center">
                        <Button.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.3"
                                Radius="10"
                                Offset="5,5" />
                        </Button.Shadow>
                    </Button>

                </StackLayout>
            </ScrollView>
        </Grid>
    </views:BaseView.Content>
</views:BaseView>