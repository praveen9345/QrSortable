<?xml version="1.0" encoding="UTF-8" ?>
<views:BaseView
    x:Class="QrSortable.Components.CoreFeatures.OrdersPayments.Views.BankTransferView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QrSortable.Resources"
    xmlns:localization="clr-namespace:QrSortable.Components.UiFunctionality.Localization"
    xmlns:views="clr-namespace:QrSortable.Components.UiFunctionality.Navigation.Views;assembly=QrSortable"
    BackgroundImageSource="{OnPlatform iOS='#525252', Android='background_layout.webp'}">

    <views:BaseView.Content>
        <Grid RowSpacing="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Back button -->
            <Button
                Grid.Row="0"
                Margin="15"
                Padding="2"
                BackgroundColor="{StaticResource DarkGrey}"
                Command="{Binding BackNavigationCommand}"
                CornerRadius="5"
                HorizontalOptions="Start"
                VerticalOptions="Start">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.5"
                        Radius="10" />
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource
                        FontFamily="FluentIcons"
                        Glyph="{x:Static local:IconNames.Back}"
                        Color="{StaticResource Primary}" />
                </Button.ImageSource>
            </Button>

            <!-- Page icon -->
            <Image
                Grid.Row="0"
                Margin="10"
                Aspect="AspectFit"
                HeightRequest="120"
                HorizontalOptions="Center"
                Source="bank_transfer"
                VerticalOptions="Center" />

            <!-- SCROLL VIEW -->
            <ScrollView Grid.Row="1" Grid.RowSpan="2">
                <VerticalStackLayout Spacing="0">

                    <!-- Order Summary Section -->
                    <VerticalStackLayout
                        Margin="15"
                        HorizontalOptions="Center"
                        Spacing="8">

                        <!-- Subtotal -->
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                HorizontalTextAlignment="Start"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_SubtotalText]}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="20"
                                HorizontalTextAlignment="Start"
                                Text="{Binding SubtotalAmount}"
                                TextColor="White"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <!-- Discount -->
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                HorizontalTextAlignment="Start"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_Discount]}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="20"
                                HorizontalTextAlignment="Start"
                                Text="{Binding DiscountAmount}"
                                TextColor="Red"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <!-- Net Total (after discount, before shipping) -->
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                HorizontalTextAlignment="Start"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_Total]}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="20"
                                HorizontalTextAlignment="Start"
                                Text="{Binding NetTotalAmount}"
                                TextColor="White"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <!-- Shipping Cost -->
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                HorizontalTextAlignment="Start"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[PaymentShipmentViewModel_ShippingCostText]}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="20"
                                HorizontalTextAlignment="Start"
                                Text="{Binding ShippingCost}"
                                TextColor="White"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <BoxView
                            BackgroundColor="White"
                            HeightRequest="2"
                            WidthRequest="250" />

                        <!-- Amount to Pay (net + shipping) -->
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="20"
                                HorizontalTextAlignment="Start"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_AmountToPay]}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="22"
                                HorizontalTextAlignment="Start"
                                Text="{Binding TotalAmount}"
                                TextColor="{StaticResource Primary}"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                    <!-- IBAN + BIC + Reference Section -->
                    <VerticalStackLayout
                        Margin="10,0,10,0"
                        Spacing="5">

                        <!-- IBAN -->
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                HorizontalTextAlignment="Start"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_IBAN]}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                HorizontalTextAlignment="Start"
                                Text="{Binding IbanCode}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Button
                                BackgroundColor="{StaticResource Primary}"
                                Command="{Binding CopyIbanCommand}"
                                CornerRadius="15"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="16"
                                HorizontalOptions="Fill"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_CopyText]}"
                                TextColor="Black"
                                VerticalOptions="Center">
                                <Button.Shadow>
                                    <Shadow
                                        Brush="Black"
                                        Opacity="0.3"
                                        Offset="5,5"
                                        Radius="10" />
                                </Button.Shadow>
                            </Button>
                        </HorizontalStackLayout>

                        <!-- BIC -->
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                HorizontalTextAlignment="Start"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_BIC]}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                HorizontalTextAlignment="Start"
                                Text="{Binding BicCode}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Button
                                BackgroundColor="{StaticResource Primary}"
                                Command="{Binding CopyBicCommand}"
                                CornerRadius="15"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="16"
                                HorizontalOptions="Fill"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_CopyText]}"
                                TextColor="Black"
                                VerticalOptions="Center">
                                <Button.Shadow>
                                    <Shadow
                                        Brush="Black"
                                        Opacity="0.3"
                                        Offset="5,5"
                                        Radius="10" />
                                </Button.Shadow>
                            </Button>
                        </HorizontalStackLayout>

                        <!-- Reference -->
                        <HorizontalStackLayout Spacing="10">
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                HorizontalTextAlignment="Start"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_ReferenceText]}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Label
                                BackgroundColor="Transparent"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="18"
                                HorizontalTextAlignment="Start"
                                Text="{Binding ReferenceCode}"
                                TextColor="{StaticResource White}"
                                VerticalTextAlignment="Center" />
                            <Button
                                BackgroundColor="{StaticResource Primary}"
                                Command="{Binding CopyReferenceCodeCommand}"
                                CornerRadius="15"
                                FontAttributes="Bold"
                                FontFamily="ItimRegular"
                                FontSize="16"
                                HorizontalOptions="Fill"
                                Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_CopyText]}"
                                TextColor="Black"
                                VerticalOptions="Center">
                                <Button.Shadow>
                                    <Shadow
                                        Brush="Black"
                                        Opacity="0.3"
                                        Offset="5,5"
                                        Radius="10" />
                                </Button.Shadow>
                            </Button>
                        </HorizontalStackLayout>

                        <Border
                            Margin="0,10,0,0"
                            Padding="20"
                            Background="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0">
                            <VerticalStackLayout Spacing="10">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="ItimRegular"
                                    FontSize="18"
                                    Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_ProvideReferenceText]}"
                                    TextColor="Black" />
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="ItimRegular"
                                    FontSize="18"
                                    Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_TransferCompletedText]}"
                                    TextColor="Black" />
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="ItimRegular"
                                    FontSize="18"
                                    Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_PlacedOrderText]}"
                                    TextColor="Black" />
                            </VerticalStackLayout>
                        </Border>

                        <Button
                            Margin="10,30,10,0"
                            BackgroundColor="{StaticResource Primary}"
                            Command="{Binding PlaceAnOrderCommand}"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontFamily="ItimRegular"
                            FontSize="20"
                            HorizontalOptions="Fill"
                            IsVisible="{Binding BankTransferVisible}"
                            Text="{Binding Source={x:Static localization:LocalizationService.Instance}, Path=[BankTransferViewModel_PlacedOrderButtText]}"
                            TextColor="Black"
                            VerticalOptions="Center">
                            <Button.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.3"
                                    Offset="5,5"
                                    Radius="10" />
                            </Button.Shadow>
                        </Button>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </views:BaseView.Content>
</views:BaseView>